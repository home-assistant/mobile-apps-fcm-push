{
  "name": "functions",
  "description": "Home Assistant mobile apps push notification service",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "start": "node webapp.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@google-cloud/logging": "^11.0.0",
    "@valkey/valkey-glide": "^2.0.1",
    "fastify": "^5.12.5",
    "firebase-admin": "^13.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "eslint": "^8.16.0",
    "eslint-plugin-promise": "^6.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "24"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "rate-limiter/*.js"
    ]
  }
}
